load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# macOS Objective-C++ file
objc_library(
    name = "host_wasi_macos_objc",
    srcs = ["macos.mm"],
    hdrs = [],
    deps = [
        "//include:headers",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

cc_library(
    name = "host_wasi",
    srcs = [
        "environ.cpp",
        "vfs_io.cpp",
        "vinode.cpp",
        "wasifunc.cpp",
        "wasimodule.cpp",
    ] + select({
        "@platforms//os:macos": [
            "clock-macos.cpp",
            "environ-macos.cpp",
            "inode-macos.cpp",
        ],
        "@platforms//os:windows": [
            "clock-win.cpp",
            "environ-win.cpp",
            "inode-win.cpp",
        ],
        "//conditions:default": [
            "clock-linux.cpp",
            "environ-linux.cpp",
            "inode-linux.cpp",
        ],
    }),
    linkopts = select({
        "@platforms//os:macos": [],
        "@platforms//os:windows": [
            "-lktmw32",
            "-lntdll",
            "-lwsock32",
            "-lws2_32",
            "-lpathcch",
            "-lshlwapi",
        ],
        "//conditions:default": ["-lrt"],
    }),
    deps = [
        "//include:headers",
        "//lib/system",
        "//thirdparty:wasi_headers",
    ] + select({
        "@platforms//os:macos": [":host_wasi_macos_objc"],
        "//conditions:default": [],
    }),
)
