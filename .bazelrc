# Enable Bzlmod (modern module system)
common --enable_bzlmod

# Build with C++20 (required for WasmEdge)
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20
build --repo_env=BAZEL_CXXOPTS=-std=c++20

# Set C++ standard via toolchain
build --copt=-std=c++20
build --host_copt=-std=c++20

# Enable optimization for release builds
build:release --compilation_mode=opt
build:release --copt=-O3
build:release --copt=-DNDEBUG

# Debug builds
build:debug --compilation_mode=dbg
build:debug --copt=-g
build:debug --strip=never

# Default to optimized builds
build --compilation_mode=opt

# Enable color diagnostics
build --color=yes

# Show test output
test --test_output=errors

# Use C++20 filesystem
build --cxxopt=-DUSE_STD_FILESYSTEM

# Platform-specific settings
build:linux --cxxopt=-fPIC
build:macos --cxxopt=-fPIC

# Enable verbose failures
build --verbose_failures

# Keep going on test failures
test --keep_going

# AOT compilation with LLVM (disabled by default)
# To enable: bazel build --config=aot //...
build:aot --define=enable_aot=true
build:aot --copt=-DWASMEDGE_ENABLE_AOT

# Without AOT (default)
build --define=enable_aot=false
